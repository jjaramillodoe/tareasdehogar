# Copia este archivo a `.env` y completa los valores. No subas `.env` a git.

# Base de datos MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="tareas_hogar"

# Seguridad JWT (genera uno largo y único: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET="cambia-esta-clave"

# CORS (en producción, orígenes concretos separados por coma)
CORS_ORIGINS="*"

# --- Correo: restablecer contraseña (Resend) ---
# 1. Crea una cuenta en https://resend.com y un API key (re_...)
# 2. En pruebas puedes usar beth.t@example.com como remitente; Resend solo entrega
#    a tu propio correo de cuenta hasta que verifiques un dominio.
# 3. En producción: verifica tu dominio y usa algo como HabitApp <hola@tudominio.com>
RESEND_API_KEY=""
EMAIL_FROM="HabitApp <beth.t@example.com>"
# EMAIL_REPLY_TO="soporte@tudominio.com"

# Enlace del botón del correo. HTTPS abre en el navegador / Expo web.
# Local (Expo web): http://localhost:8081/reset-password
# Producción web:   https://tudominio.com/reset-password
PASSWORD_RESET_LINK_BASE="http://localhost:8081/reset-password"

# Opcional: deep link nativo (se muestra como enlace secundario)
PASSWORD_RESET_APP_LINK_BASE="habitapp://reset-password"

# Caducidad del token (minutos)
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"

# Alternativa a Resend: POST JSON a tu propio servicio (SendGrid, Make, etc.)
# PASSWORD_RESET_EMAIL_WEBHOOK_URL=""
# PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=""
